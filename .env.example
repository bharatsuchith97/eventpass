# ---- EventPass production configuration: copy to .env and fill in every empty value ----
# Generate secrets with:  openssl rand -hex 32

# Your domain, without https:// (e.g. events.example.com). Its DNS A record must point at this server.
# Caddy gets the HTTPS certificate for it and the app's public URL becomes https://$DOMAIN.
DOMAIN=

# Password for the bundled PostgreSQL container. Use hex (openssl rand -hex 32): it goes inside a connection
# URL, so characters like @ : / would break it.
DB_PASSWORD=

# Optional: use a managed PostgreSQL (Supabase, Neon, Render, ...) instead of the bundled container.
# Leave empty to use the container. Example: postgres://user:password@host:5432/dbname?sslmode=require
DATABASE_URL=

# Signs session tokens.
JWT_SECRET=

# Platform superadmin: approves company signups at https://$DOMAIN/admin. Created on boot; changing the
# password here and restarting resets it. Use a long, unique password (12+ characters).
SUPERADMIN_EMAIL=
SUPERADMIN_PASSWORD=

# Outgoing email (invitations, passes, approvals, password reset), e.g. from Brevo or Resend:
#   smtp://LOGIN:SMTP_KEY@smtp-relay.brevo.com:587   or   smtps://resend:API_KEY@smtp.resend.com:465
# Write any @ inside the login or key as %40 (it is a URL). MAIL_FROM must use an address on a domain you
# have verified with that provider.
SMTP_URL=
MAIL_FROM=EventPass <no-reply@example.com>

# ---- Usually no need to change anything below ----
NODE_ENV=production
PORT=4000
SESSION_HOURS=8
DB_POOL_MAX=20
# APP_URL and TRUST_PROXY are set by docker-compose.yml.
